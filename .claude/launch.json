{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.local/node/bin:$PATH\" && npm run dev"],
      "port": 3000
    },
    {
      "name": "dev-3001",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.local/node/bin:$PATH\" && NEXTAUTH_URL=http://localhost:3001 npx next dev -p 3001"],
      "port": 3001,
      "autoPort": false
    }
  ]
}
